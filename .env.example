# Public Supabase client configuration (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
DATABASE_URL=


# OTP security secret (required for phone verification API routes)
PHONE_OTP_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# OTP delivery mode:
# - simulate: returns dev OTP preview in API response (prototype only)
# - webhook: sends SMS through your webhook endpoint (production recommended)
PHONE_OTP_MODE=simulate

# Required only when PHONE_OTP_MODE=webhook
PHONE_OTP_SMS_WEBHOOK_URL=
PHONE_OTP_SMS_WEBHOOK_TOKEN=

